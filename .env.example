# Flask API (api_server.py)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# When set, POST /scrape, /signup, /process_mcp, and payment routes require: X-API-Key: <value>
CLAIMS_API_KEY=

# Optional override for dataset path (tests use a temp file)
# CLAIMS_DATASET_FILE=claims_dataset.json

# Paperclip / tools.py client
CLAIMS_API_BASE=http://127.0.0.1:5000
CLAIMS_HTTP_TIMEOUT=30

# Comma-separated origins allowed for browser signup from index.html
CLAIMS_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://no-proof-claims.com,https://www.no-proof-claims.com

# --- Stripe (Connect payouts) ---
# Leave STRIPE_SECRET_KEY empty locally to use mock mode (no real API calls).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Force mock even if a key is present (tests)
STRIPE_MOCK_MODE=true

# Payout split rates (must sum to 1.0 when w_fund_promise is true)
WAR_CHEST_RATE=0.20
W_FUND_RATE=0.29
CLAIMANT_RATE=0.51

# After Connect onboarding redirects
STRIPE_CONNECT_RETURN_URL=https://no-proof-claims.com/signup?onboarding=complete
STRIPE_CONNECT_REFRESH_URL=https://no-proof-claims.com/signup?onboarding=refresh
