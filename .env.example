# Flask API (api_server.py)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# When set, POST /scrape, /signup, and /process_mcp require header: X-API-Key: <value>
CLAIMS_API_KEY=

# Optional override for dataset path (tests use a temp file)
# CLAIMS_DATASET_FILE=claims_dataset.json

# Paperclip / tools.py client
CLAIMS_API_BASE=http://127.0.0.1:5000
CLAIMS_HTTP_TIMEOUT=30

# Comma-separated origins allowed for browser signup from index.html
CLAIMS_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
